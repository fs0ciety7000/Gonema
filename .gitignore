# Secrets en clair : jamais dans git (les fichiers chiffrés secrets/*.enc.json, eux, sont commitables)
.env
.env.*
!.env.example
!.env.tpl
*.pem
*.key
secrets/*.dec.*
secrets/*.plain.*

# Données locales
pb_data/
/data/
*.sqlite
*.db

# Dépendances et builds
node_modules/
dist/
build/
.next/
.wrangler/
target/
.godot/

# Éditeurs et système
.DS_Store
.idea/
.vscode/

# Claude Code : réglages locaux personnels
.claude/settings.local.json

# Go
bin/

# SPA copied by `make web` and embedded by internal/webui (only the keep file is tracked)
!internal/webui/dist/
internal/webui/dist/*
!internal/webui/dist/.gitkeep

# Heavy third-party skills (~54 MB of assets): reinstall with `kit project add design-ui brand`
.claude/skills/design-taste-frontend/
.claude/skills/logo-design/

# Full-page design renders: regenerate with docs/design/tools/render.js
docs/design/renders/*-full-*.jpg
/gonema
