    "e2e:fresh": "node --test --test-concurrency=1 \"e2e/fresh/*.test.mjs\"",
    "perf": "node e2e/perf.mjs",
    "budget": "node tools/check-budget.mjs",
    "fidelity": "node e2e/fidelity.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.26",
    "cmdk": "1.1.1",
    "lucide-react": "1.71.0",
    "motion": "14.12.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
