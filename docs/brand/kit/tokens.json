      },
      "mono": {
        "family": "mono",
        "size": 13,
        "lineHeight": 20,
        "weight": 400,
        "tracking": "0",
        "use": "Release names, paths, scores, logs"
      },
      "mono-sm": {
        "family": "mono",
        "size": 12,
        "lineHeight": 16,
        "weight": 400,
        "tracking": "0",
        "use": "Table cells, sizes, timestamps"
      }
    },
    "numerals": "All figures in UI text use font-variant-numeric: tabular-nums (Geist supports tnum); Geist Mono is tabular by construction. Use slashed-zero (zero) in mono for hashes and release names.",
    "rules": [
      "Archivo is always set at wdth 125 (expanded); never below 500 weight.",
      "No weight below 400 under 16px (Geist).",
      "Film titles in display styles use title case, overline uses caps."
    ]
